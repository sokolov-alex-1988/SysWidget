<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Без этого переключателя WPF игнорирует смену DPI при переносе окна на
         другой монитор: карточка остаётся в масштабе старого монитора. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
